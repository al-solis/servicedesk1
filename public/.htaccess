# <IfModule mod_headers.c>
# Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://trusted.cdn.com; style-src 'self' https://trusted.cdn.com; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none';"
# Header set X-Content-Type-Options "nosniff"
# Header set X-Frame-Options "DENY"
# Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
